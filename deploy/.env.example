# Deployment configuration for compose.traefik.yml (integrating behind an
# existing Traefik). Copy to deploy/.env and fill in. deploy/.env is git-ignored
# because the hostnames it names are tenant data, not source.
#
#   cp deploy/.env.example deploy/.env

# Base domain that subdomains are resolved under.
BASE_DOMAIN=example.com

# The existing Traefik's docker network, and its ACME certificate resolver name.
# Find them with:  docker inspect <traefik-container> --format '{{json .Config.Cmd}}'
PROXY_NETWORK=root_default
ACME_RESOLVER=mytlschallenge

# Which hostnames this deployment answers for. A full Traefik rule, so several
# tenants can share one router:
#   DEMO_ROUTER_RULE=Host(`one.example.com`) || Host(`two.example.com`)
# Backticks are required by Traefik and are preserved literally by compose.
DEMO_ROUTER_RULE=Host(`demo.example.com`)

# Where the SQLite tenant store lives on the host.
DATA_DIR=/srv/grindctrl/data
